# =========================================================================
# Kopie — web-eleve (développement, hot-reload)
# Build context : racine du monorepo (cf. docker-compose.yml).
# Version Node alignée sur .nvmrc et engines.node (package.json racine).
# =========================================================================
FROM node:22.12.0-alpine

WORKDIR /app

RUN npm install -g corepack@latest
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/shared-types ./packages/shared-types
COPY apps/web-eleve/package.json ./apps/web-eleve/

RUN pnpm install --filter web-eleve... --frozen-lockfile

COPY apps/web-eleve ./apps/web-eleve

EXPOSE 5174

CMD ["pnpm", "--filter", "web-eleve", "dev", "--host", "0.0.0.0"]
