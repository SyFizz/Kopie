+# =========================================================================
+# Kopie ÔÇö Variables d'environnement
+# Copier en `.env` et adapter pour le d+®veloppement local.
+# Ne JAMAIS commiter `.env` (NFR-4).
+# =========================================================================
+
+# --- Base de donn+®es ----------------------------------------------------
+DATABASE_URL=postgresql+asyncpg://kopie:kopie@localhost:5432/kopie
+POSTGRES_USER=kopie
+POSTGRES_PASSWORD=kopie
+POSTGRES_DB=kopie
+
+# --- API ----------------------------------------------------------------
+# OBLIGATOIRE ÔÇö g+®n+®rer avec : openssl rand -hex 32
+# Laisser vide ici ; docker compose +®choue volontairement si non d+®fini (NFR-4).
+SECRET_KEY=
+ACCESS_TOKEN_EXPIRE_MINUTES=15
+REFRESH_TOKEN_EXPIRE_DAYS=7
+
+# --- CORS (liste JSON) --------------------------------------------------
+# Lue +á la fois par docker-compose.yml (injection) et par l'API (Pydantic Settings).
+# En staging/prod : remplacer par les origines r+®elles (https://prof.kopie.cc, etc.).
+CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
+
+# --- SMTP (placeholder ÔÇö Story 1.3) -------------------------------------
+SMTP_HOST=
+SMTP_PORT=587
+SMTP_USER=
+SMTP_PASSWORD=
+
+# --- R+®tention donn+®es +®l+¿ve (FR-41) ------------------------------------
+DATA_RETENTION_MONTHS=12
+
+# --- Rate limiting (FR-43 ÔÇö seuils ajustables) --------------------------
+RATE_LIMIT_AUTH=10/minute
+RATE_LIMIT_STUDENT_ANSWERS=60/minute
+RATE_LIMIT_STUDENT_EVENTS=30/minute
+RATE_LIMIT_STUDENT_SUBMIT=5/minute
