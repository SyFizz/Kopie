# =========================================================================
# Kopie — Variables d'environnement
# Copier en `.env` et adapter pour le développement local.
# Ne JAMAIS commiter `.env` (NFR-4).
# =========================================================================

# --- Base de données ----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://kopie:kopie@localhost:5432/kopie
POSTGRES_USER=kopie
POSTGRES_PASSWORD=kopie
POSTGRES_DB=kopie

# --- API ----------------------------------------------------------------
# OBLIGATOIRE — générer avec : openssl rand -hex 32
# Laisser vide ici ; docker compose échoue volontairement si non défini (NFR-4).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (liste JSON) --------------------------------------------------
# Lue à la fois par docker-compose.yml (injection) et par l'API (Pydantic Settings).
# En staging/prod : remplacer par les origines réelles (https://prof.kopie.cc, etc.).
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# --- SMTP (Story 1.3 — validation email enseignant) ---------------------
# En dev local : laisser SMTP_HOST vide → les emails de vérification sont
# uniquement loggués (mode dégradé, voir app/services/email_service.py).
# En staging/prod : configurer un serveur SMTP réel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- URL de base de l'API (Story 1.3) -----------------------------------
# Utilisée pour construire le lien de confirmation dans l'email de vérification.
# Pointer vers l'URL publique de l'API (en prod : https://api.kopie.cc).
APP_BASE_URL=http://localhost:8000

# --- Rétention données élève (FR-41) ------------------------------------
DATA_RETENTION_MONTHS=12

# --- Contrat OpenAPI (source de vérité unique pour /docs et /openapi.json) --
# Dev local hors Docker : chemin relatif à apps/api (commande uvicorn lancée
# depuis apps/api). Docker Compose surcharge cette valeur à /contracts/openapi.yaml
# (mount read-only). Ne pas modifier sauf cas spécifique.
OPENAPI_CONTRACT_PATH=../../contracts/openapi.yaml

# --- Rate limiting (FR-43 — seuils ajustables) --------------------------
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_STUDENT_ANSWERS=60/minute
RATE_LIMIT_STUDENT_EVENTS=30/minute
RATE_LIMIT_STUDENT_SUBMIT=5/minute
