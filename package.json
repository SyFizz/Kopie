{
  "name": "kopie",
  "version": "0.1.0",
  "private": true,
  "description": "Kopie — Plateforme d'évaluation sécurisée (monorepo)",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0 <23.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:prof": "pnpm --filter web-prof dev",
    "dev:eleve": "pnpm --filter web-eleve dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "gen:types": "openapi-typescript contracts/openapi.yaml -o packages/shared-types/src/api.ts"
  },
  "packageManager": "pnpm@10.33.4",
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
